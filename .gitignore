# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies
__pycache__/
*.pyc
.dart_tool/
# The unpacked xvfb package; lab/tool/xvfb.sh rebuilds it.
lab/tool/.xvfb/
# Call recordings (screen and sound) stay on disk only (Grey 2026-10-16): a 3-minute Alice
# recording is ~105 MB, over GitHub's 100 MiB file limit. The numbers taken
# from them go in results/<label>.jsonl, which is committed. The 30-second
# recordings from calls1-5 were committed before this rule and stay.
lab/gate2/results/**/*.mp4
lab/gate2/results/**/*.mkv
lab/gate2/results/**/*.wav
# The sound recordings' packet logs (voice_delay.record_cmd, from 2026-10-17):
# about 27 KB per second of recording, ~10 MB per 5-minute call. Disk only,
# like the recordings; each derived start time is kept in the summary line
# (voice.sent_start / voice.heard_start).
lab/gate2/results/**/*_sent_record.log
lab/gate2/results/**/*_heard_record.log
lab/gate2/results/pulse-stamp-check/a_record.log
lab/gate2/results/pulse-stamp-check/b_record.log
